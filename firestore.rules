rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // QR Codes Collection
    match /qrCodes/{qrCodeId} {
      // Public single-read allows physical scanning of plaques to redirect (/q/:id)
      allow get: if true;
      // List permitted for authenticated users
      allow list: if isSignedIn();
      // Creation allowed by authenticated users
      allow create: if isSignedIn();
      // Update by authenticated users or public scan counter update
      allow update: if isSignedIn() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scanCount', 'updatedAt']);
      allow delete: if isSignedIn();
    }

    // Batches Collection
    match /batches/{batchId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Counters Collection for atomic sequence allocation
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}

